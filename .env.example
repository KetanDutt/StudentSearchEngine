# FindinG - Environment Variables Example
# Copy to .env and configure

# Database
DB_URL=jdbc:mysql://localhost:3306/project?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=toor
DB_POOL_SIZE=10

# App
APP_ENV=production
APP_SECRET=change_this_to_random_32_char_string
SESSION_TIMEOUT=30

# Optional: For Docker
MYSQL_ROOT_PASSWORD=toor
MYSQL_DATABASE=project
MYSQL_USER=finding_user
MYSQL_PASSWORD=finding_pass_2026
